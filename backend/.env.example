# EcoMind AI - Backend Environment Configuration

# Application
PROJECT_NAME="EcoMind AI - Enterprise Sustainability Intelligence Platform"
API_V1_STR="/api/v1"
DEBUG=True
ENVIRONMENT="development"

# CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:4173"]

# Database Configuration
# Default: Local zero-config SQLite database.
# For production PostgreSQL: postgresql+psycopg://username:password@localhost:5432/ecomind
DATABASE_URL="sqlite:///./ecomind.db"

# Storage Directories
UPLOAD_DIR="./uploads"
EXPORTS_DIR="./exports"
REPORTS_DIR="./reports_pdf"

# Default Grid Carbon Emission Factor (in kg CO2e / kWh)
# Defaults to US EPA eGRID national average: 0.386 kg CO2e / kWh
DEFAULT_EMISSION_FACTOR=0.386
DEFAULT_EMISSION_FACTOR_NAME="US EPA eGRID National Average"

# Default Energy Tariff ($ / kWh) for monetary savings estimations
DEFAULT_ENERGY_TARIFF=0.14

# IoT & Smart Meter Configuration
IOT_API_KEY="ecomind-iot-ingest-key-2026"
MQTT_BROKER_HOST="localhost"
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX="ecomind/meters"
MQTT_CLIENT_ID="ecomind-backend-subscriber"
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_ENABLED=False

# ERP Integration Secret (Internal secret for token hashing/masking)
ERP_ENCRYPTION_SECRET="ecomind-erp-safe-secret-key"

# Optional: External LLM for Assistant (Fallback deterministic engine operates if not provided)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
